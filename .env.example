# Salin menjadi .env.local lalu isi. Jangan pernah commit file .env*.
# Tanpa kunci ini aplikasi tetap jalan: "Foto Buku KIA" dibaca di perangkat dengan Tesseract (bagus untuk huruf cetak,
# sering meleset untuk tulisan tangan). Dengan kunci, foto dibaca Gemini yang jauh lebih baik untuk tulisan tangan.
# Kunci gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional. Model vision yang dipakai untuk membaca foto tabel Buku KIA.
GEMINI_MODEL=gemini-2.5-flash
