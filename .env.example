# Salin menjadi .env.local lalu isi. Jangan pernah commit file .env*.
# Tanpa kunci ini aplikasi tetap jalan: "Foto Buku KIA" dibaca di perangkat dengan Tesseract (bagus untuk huruf cetak,
# sering meleset untuk tulisan tangan). Dengan kunci, foto dibaca Gemini yang jauh lebih baik untuk tulisan tangan.
# Kunci gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsional. Model vision yang dipakai untuk membaca foto tabel Buku KIA.
GEMINI_MODEL=gemini-3.8-flash

# Opsional. Tautan unduhan APK aplikasi Android Rangkul (mobile/). Bila diisi, tab Ibu pada
# layar masuk menampilkan tautan unduhnya di bawah akun ibu.
NEXT_PUBLIC_URL_APK=

# Opsional. Sambungkan ke Supabase agar data web petugas dan aplikasi Android Ibu sama.
# Kosong = mode demo, data dibuat di browser masing-masing. Lihat README bagian "Menyambungkan ke Supabase".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya untuk `npm run seed:supabase` di komputer sendiri. JANGAN diisi di Vercel atau dibagikan.
SUPABASE_SECRET_KEY=
